@startuml
title Diagrama de clases de dominio - Inmobiliaria
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 6

skinparam backgroundColor #F8FAFC

skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #1E293B
  BorderColor #334155
  BorderThickness 1.5
  FontSize 11
  FontColor #1E293B
  FontName "Segoe UI", Helvetica, Arial, sans-serif
}

skinparam arrow {
  Color #475569
  Thickness 1.5
  FontColor #0F172A
  FontSize 10
}

skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  BorderThickness 1.5
  FontColor #334155
  RoundCorner 6
}

class Propietario {
  +int Id
  +string Dni
  +string Nombre
  +string Apellido
  +string Telefono
  +string Email
  +bool Estado
  +string NombreCompleto {readOnly}
  __
  +string ToString()
}

class Inquilino {
  +int Id
  +string Dni
  +string Nombre
  +string Apellido
  +string Telefono
  +string Email
  +bool Estado
  +string NombreCompleto {readOnly}
  __
  +string ToString()
}

class TipoInmueble {
  +int Id
  +string Descripcion
  +bool Estado
  __
  +string ToString()
}

class Usuario {
  +int Id
  +string Nombre
  +string Apellido
  +string Email
  +string PasswordHash
  +string Rol
  +string? Avatar
  +bool Estado
  +string NombreCompleto {readOnly}
  __
  +bool EsAdmin()
  +bool EsEmpleado()
}

class Inmueble {
  +int Id
  +string Direccion
  +int Cupo
  +TipoInmueble Tipo
  +string? Coordenadas
  +decimal PrecioDia
  +int PorcentajeReserva
  +string? Portada
  +bool Disponible
  +Propietario Propietario
  +bool Estado
  +List<FotoInmueble> Fotos
  __
  +decimal CalcularSena(int dias)
  +bool PuedeAlojar(int personas)
}

class FotoInmueble {
  +int Id
  +Inmueble Inmueble
  +string UrlFoto
}

class Reserva {
  +int Id
  +Inmueble Inmueble
  +Inquilino Inquilino
  +DateTime FechaInicio
  +DateTime FechaFin
  +decimal MontoDiario
  +DateTime? FechaFinEfectiva
  +decimal? Multa
  +Usuario UsuarioCreador
  +Usuario? UsuarioFinalizador
  +bool Estado
  +List<Pago> Pagos
  __
  +int CantidadDias()
  +decimal MontoTotal()
  +decimal TotalPagado()
  +decimal SaldoPendiente()
  +decimal CalcularMulta(DateTime fechaEfectiva)
  +bool EsVigente(DateTime fecha)
}

class Pago {
  +int Id
  +Reserva Reserva
  +string Concepto
  +DateTime FechaPago
  +decimal Importe
  +Usuario UsuarioCreador
  +Usuario? UsuarioAnulador
  +bool Anulado
  __
  +void Anular(Usuario anulador)
  +bool EsValido()
}

Inmueble "0..*" --> "1" TipoInmueble : se clasifica en
Inmueble "0..*" --> "1" Propietario : pertenece a
Inmueble "1" *-- "0..*" FotoInmueble : contiene
Reserva "0..*" --> "1" Inmueble : reserva
Reserva "0..*" --> "1" Inquilino : es realizada por
Reserva "0..*" --> "1" Usuario : es creada por
Reserva "0..*" --> "0..1" Usuario : es finalizada por
Reserva "1" o-- "0..*" Pago : registra pagos
Pago "0..*" --> "1" Reserva : abona a
Pago "0..*" --> "1" Usuario : es registrado por
Pago "0..*" --> "0..1" Usuario : es anulado por

note right of Propietario
  NombreCompleto es propiedad calculada.
end note

note right of Inmueble
  Fotos es composición (1 a 0..*).
end note

note right of Reserva
  En Nivel A encapsula sus Pagos (1 a 0..*),
  calcula SaldoPendiente, MontoTotal y Multa.
end note

note bottom of Usuario
  PasswordHash se mapea a password en BD.
end note
@enduml
