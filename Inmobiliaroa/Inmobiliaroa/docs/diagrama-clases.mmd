%% Diagrama de clases del dominio Inmobiliaria (Nivel A)
classDiagram
    direction TB
    class Propietario {
        +int Id
        +string Dni
        +string Nombre
        +string Apellido
        +string Telefono
        +string Email
        +bool Estado
        +string NombreCompleto
        +string ToString()
    }
    class Inquilino {
        +int Id
        +string Dni
        +string Nombre
        +string Apellido
        +string Telefono
        +string Email
        +bool Estado
        +string NombreCompleto
        +string ToString()
    }
    class TipoInmueble {
        +int Id
        +string Descripcion
        +bool Estado
        +string ToString()
    }
    class Usuario {
        +int Id
        +string Nombre
        +string Apellido
        +string Email
        +string PasswordHash
        +string Rol
        +string? Avatar
        +bool Estado
        +string NombreCompleto
        +bool EsAdmin()
        +bool EsEmpleado()
    }
    class Inmueble {
        +int Id
        +string Direccion
        +int Cupo
        +TipoInmueble Tipo
        +string? Coordenadas
        +decimal PrecioDia
        +int PorcentajeReserva
        +string? Portada
        +bool Disponible
        +Propietario Propietario
        +bool Estado
        +List~FotoInmueble~ Fotos
        +decimal CalcularSena(int dias)
        +bool PuedeAlojar(int personas)
    }
    class FotoInmueble {
        +int Id
        +Inmueble Inmueble
        +string UrlFoto
    }
    class Reserva {
        +int Id
        +Inmueble Inmueble
        +Inquilino Inquilino
        +DateTime FechaInicio
        +DateTime FechaFin
        +decimal MontoDiario
        +DateTime? FechaFinEfectiva
        +decimal? Multa
        +Usuario UsuarioCreador
        +Usuario? UsuarioFinalizador
        +bool Estado
        +List~Pago~ Pagos
        +int CantidadDias()
        +decimal MontoTotal()
        +decimal TotalPagado()
        +decimal SaldoPendiente()
        +decimal CalcularMulta(DateTime fechaEfectiva)
        +bool EsVigente(DateTime fecha)
    }
    class Pago {
        +int Id
        +Reserva Reserva
        +string Concepto
        +DateTime FechaPago
        +decimal Importe
        +Usuario UsuarioCreador
        +Usuario? UsuarioAnulador
        +bool Anulado
        +void Anular(Usuario anulador)
        +bool EsValido()
    }

    Inmueble "0..*" --> "1" TipoInmueble : se clasifica en
    Inmueble "0..*" --> "1" Propietario : pertenece a
    Inmueble "1" *-- "0..*" FotoInmueble : contiene
    Reserva "0..*" --> "1" Inmueble : reserva
    Reserva "0..*" --> "1" Inquilino : es realizada por
    Reserva "0..*" --> "1" Usuario : es creada por
    Reserva "0..*" --> "0..1" Usuario : es finalizada por
    Reserva "1" o-- "0..*" Pago : registra pagos
    Pago "0..*" --> "1" Reserva : abona a
    Pago "0..*" --> "1" Usuario : es registrado por
    Pago "0..*" --> "0..1" Usuario : es anulado por

    note for Propietario "NombreCompleto es una propiedad calculada"
    note for Inquilino "NombreCompleto es una propiedad calculada"
    note for Inmueble "Fotos es una composición (1 a 0..*)"
    note for Reserva "Encapsula Pagos (1 a 0..*) y métodos de cálculo"

    classDef propStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef inqStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef tipoStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef inmStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef fotoStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef resStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef pagoStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A
    classDef usrStyle fill:#FFFFFF,stroke:#334155,stroke-width:1.5px,color:#0F172A

    Propietario:::propStyle
    Inquilino:::inqStyle
    TipoInmueble:::tipoStyle
    Inmueble:::inmStyle
    FotoInmueble:::fotoStyle
    Reserva:::resStyle
    Pago:::pagoStyle
    Usuario:::usrStyle
