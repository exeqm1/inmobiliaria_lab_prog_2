        <mxCell id="nota_er" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;fontFamily=Helvetica;spacingLeft=8;spacingRight=8;spacingTop=6;fontColor=#334155;strokeWidth=1.5;arcSize=6;shadow=0;" value="&lt;b&gt;Índices&lt;/b&gt;&lt;br&gt;Propietarios: idx_propietario_dni (dni), idx_propietario_estado (estado)&lt;br&gt;Inquilinos: idx_inquilino_dni (dni), idx_inquilino_estado (estado)&lt;br&gt;Inmuebles: idx_inmueble_disp_estado (disponible, estado), idx_inmueble_propietario (propietario_id)&lt;br&gt;Reservas: idx_reserva_rango (inmueble_id, fecha_inicio, fecha_fin, estado)&lt;br&gt;Pagos: idx_pago_reserva (reserva_id, anulado)&lt;br&gt;&lt;br&gt;&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;password (BD) = PasswordHash (C#)&lt;br&gt;estado / anulado = baja lógica&lt;br&gt;NombreCompleto = atributo calculado, no columna&lt;br&gt;Fotos_Inmueble: única FK con ON DELETE CASCADE&lt;br&gt;Resto de FK: RESTRICT/NO ACTION&lt;br&gt;NULL = opcional; sin NULL = NOT NULL" vertex="1">
