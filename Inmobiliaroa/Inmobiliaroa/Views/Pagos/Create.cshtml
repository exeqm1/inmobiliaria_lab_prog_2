@model PagoFormViewModel

@{
    ViewData["Title"] = "Nuevo Pago";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-cash-stack me-2"></i>Registrar Pago
                </h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted">
                    Reserva <strong>#@Model.ReservaId</strong> — @Model.InmuebleDescripcion
                </p>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="ReservaId" />
                    <input type="hidden" asp-for="InmuebleDescripcion" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Concepto" class="form-label fw-bold"></label>
                        <input asp-for="Concepto" class="form-control" list="conceptosSugeridos" autofocus />
                        <datalist id="conceptosSugeridos">
                            <option value="Seña"></option>
                            <option value="Saldo"></option>
                            <option value="Multa terminación anticipada"></option>
                        </datalist>
                        <span asp-validation-for="Concepto" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Importe" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Importe" class="form-control" />
                        </div>
                        <span asp-validation-for="Importe" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        La fecha y el importe no podrán editarse una vez registrado el pago (solo anularse).
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Index" asp-route-reservaId="@Model.ReservaId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i>Registrar Pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
