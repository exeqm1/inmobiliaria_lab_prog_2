@model Inmueble

@{
    ViewData["Title"] = "Detalle del Inmueble";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <div class="card">
            <div class="card-header py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-building me-2"></i>Inmueble #@Model.Id
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-5 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Portada))
                        {
                            <img src="@Model.Portada" alt="Portada" class="img-fluid rounded border detail-cover" />
                        }
                        else
                        {
                            <div class="placeholder-box d-flex align-items-center justify-content-center text-muted">
                                <div class="text-center">
                                    <i class="bi bi-image display-4 d-block"></i>Sin portada
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-7">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Dirección</dt>
                            <dd class="col-sm-7">@Model.Direccion</dd>

                            <dt class="col-sm-5">Tipo</dt>
                            <dd class="col-sm-7">@Model.Tipo?.Descripcion</dd>

                            <dt class="col-sm-5">Propietario</dt>
                            <dd class="col-sm-7">@Model.Propietario?.NombreCompleto</dd>

                            <dt class="col-sm-5">Cupo</dt>
                            <dd class="col-sm-7">@Model.Cupo personas</dd>

                            <dt class="col-sm-5">Precio por Día</dt>
                            <dd class="col-sm-7">$@Model.PrecioDia.ToString("N2")</dd>

                            <dt class="col-sm-5">Porcentaje de Reserva</dt>
                            <dd class="col-sm-7">@Model.PorcentajeReserva %</dd>

                            <dt class="col-sm-5">Coordenadas</dt>
                            <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Coordenadas) ? "—" : Model.Coordenadas)</dd>

                            <dt class="col-sm-5">Disponibilidad</dt>
                            <dd class="col-sm-7">
                                @if (Model.Disponible)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">No disponible</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                @if (Model.Fotos.Any())
                {
                    <hr />
                    <h6 class="fw-bold mb-3"><i class="bi bi-images me-1"></i>Galería</h6>
                    <div class="row g-2">
                        @foreach (var foto in Model.Fotos)
                        {
                            <div class="col-6 col-md-3">
                                <img src="@foto.UrlFoto" alt="Foto del inmueble" class="img-fluid rounded border thumb-gallery" />
                            </div>
                        }
                    </div>
                }

                <div class="d-flex justify-content-between pt-3 mt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver al Listado
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
