@model Inquilino

@{
    ViewData["Title"] = "Detalle del Inquilino";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="bi bi-person-lines-fill me-2"></i>Ficha del Inquilino
                </h5>
                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo / Baja</span>
                }
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Código ID</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">DNI</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Dni</dd>

                    <dt class="col-sm-4 text-muted">Nombre Completo</dt>
                    <dd class="col-sm-8">@Model.NombreCompleto</dd>

                    <dt class="col-sm-4 text-muted">Teléfono</dt>
                    <dd class="col-sm-8">
                        <a href="tel:@Model.Telefono" class="text-decoration-none">
                            <i class="bi bi-telephone me-1"></i>@Model.Telefono
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-muted">Correo Electrónico</dt>
                    <dd class="col-sm-8">
                        <a href="mailto:@Model.Email" class="text-decoration-none">
                            <i class="bi bi-envelope me-1"></i>@Model.Email
                        </a>
                    </dd>
                </dl>
            </div>
            <div class="card-footer py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver al Listado
                </a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-1">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Dar de baja
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

