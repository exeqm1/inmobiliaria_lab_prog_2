@{
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavActivo(string c) => string.Equals(controllerActual, c) ? "active" : "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Inmobiliario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-houses me-2"></i>Inmobiliaria
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActivo("Propietarios")" asp-controller="Propietarios" asp-action="Index">
                                    <i class="bi bi-person-badge me-1"></i>Propietarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActivo("Inquilinos")" asp-controller="Inquilinos" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Inquilinos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActivo("TiposInmueble")" asp-controller="TiposInmueble" asp-action="Index">
                                    <i class="bi bi-house-gear me-1"></i>Tipos de Inmueble
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActivo("Inmuebles")" asp-controller="Inmuebles" asp-action="Index">
                                    <i class="bi bi-buildings me-1"></i>Inmuebles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActivo("Reservas")" asp-controller="Reservas" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i>Reservas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActivo("Reportes")" asp-controller="Reportes" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow me-1"></i>Reportes
                                </a>
                            </li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @NavActivo("Usuarios")" asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-person-gear me-1"></i>Usuarios
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <span class="dropdown-item-text small text-muted">
                                            <i class="bi bi-shield-check me-1"></i>@(User.IsInRole("Administrador") ? "Administrador" : "Empleado")
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Perfil">
                                            <i class="bi bi-person-circle me-1"></i>Mi Perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-1">
                                            <button type="submit" class="btn btn-link dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <!-- Notificaciones y Feedback Flash -->
        @if (TempData["Mensaje"] != null)
        {
            var tipo = TempData["TipoMensaje"]?.ToString() ?? "info";
            <div class="alert alert-@tipo alert-dismissible fade show" role="alert">
                @if (tipo == "success")
                {
                    <i class="bi bi-check-circle-fill me-2"></i>
                }
                else if (tipo == "danger")
                {
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                }
                else
                {
                    <i class="bi bi-info-circle-fill me-2"></i>
                }
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; @DateTime.Now.Year - Gestión de Alquileres Temporarios | Laboratorio de Programación II</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

