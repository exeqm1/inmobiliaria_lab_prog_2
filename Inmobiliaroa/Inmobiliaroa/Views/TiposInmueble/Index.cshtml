@model PaginacionResultado<TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-house-gear text-primary me-2"></i>Tipos de Inmueble
        </h2>
        <small class="text-muted">Total registrados: @Model.TotalElementos</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nuevo Tipo
    </a>
</div>

<!-- Filtro de Búsqueda por Servidor -->
<div class="card mb-4">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <input type="hidden" name="pagina" value="1" />
            <div class="col-md-9 col-sm-8">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="busqueda" value="@Model.CriterioBusqueda"
                           class="form-control" placeholder="Buscar por descripción..." />
                </div>
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.CriterioBusqueda))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtro">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 120px;">Código</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-center" style="width: 100px;">Estado</th>
                    <th scope="col" class="text-end" style="width: 160px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Any())
                {
                    foreach (var item in Model.Elementos)
                    {
                        <tr>
                            <td class="fw-semibold">#@item.Id</td>
                            <td>@item.Descripcion</td>
                            <td class="text-center">
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Dar de baja">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No se encontraron tipos de inmueble @(!string.IsNullOrEmpty(Model.CriterioBusqueda) ? "con ese criterio de búsqueda" : "").
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación por Servidor -->
    @if (Model.TotalPaginas > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">
                Página @Model.PaginaActual de @Model.TotalPaginas
            </span>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaActual - 1)"
                           asp-route-busqueda="@Model.CriterioBusqueda">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-busqueda="@Model.CriterioBusqueda">@i</a>
                        </li>
                    }

                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaActual + 1)"
                           asp-route-busqueda="@Model.CriterioBusqueda">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
