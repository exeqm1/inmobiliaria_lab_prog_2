@model TipoInmueble

@{
    ViewData["Title"] = "Dar de baja Tipo de Inmueble";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Baja Lógica de Tipo de Inmueble
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4" role="alert">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Atención:</strong> Esta acción marcará el tipo como <strong>inactivo</strong> en el sistema (baja lógica).
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Código ID</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Descripción</dt>
                    <dd class="col-sm-8">@Model.Descripcion</dd>
                </dl>
            </div>
            <div class="card-footer py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Cancelar
                </a>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i>Confirmar Baja
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
