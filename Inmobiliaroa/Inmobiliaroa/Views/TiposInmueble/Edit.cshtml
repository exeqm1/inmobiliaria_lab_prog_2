@model TipoInmueble

@{
    ViewData["Title"] = "Editar Tipo de Inmueble";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header bg-warning-subtle text-warning-emphasis py-3 border-bottom border-warning-subtle">
                <h5 class="card-title mb-0">
                    <i class="bi bi-pencil-square me-2"></i>Editar Tipo de Inmueble #@Model.Id
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Estado" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-bold"></label>
                        <input asp-for="Descripcion" class="form-control" autofocus />
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver al Listado
                        </a>
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-check-circle me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
