@model ReservaFormViewModel

@{
    ViewData["Title"] = "Editar Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-pencil-square me-2"></i>Editar Reserva #@Model.Id
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="InmuebleId" />
                    <input type="hidden" asp-for="MontoDiario" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Inmueble</label>
                        <input type="text" class="form-control" value="@Model.InmuebleDescripcion" disabled />
                        <div class="form-text">El inmueble y el monto diario no pueden modificarse una vez creada la reserva.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InquilinoId" class="form-label fw-bold"></label>
                        <select asp-for="InquilinoId" asp-items="ViewBag.Inquilinos" class="form-select">
                            <option value="">-- Seleccione un inquilino --</option>
                        </select>
                        <span asp-validation-for="InquilinoId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicio" class="form-label fw-bold"></label>
                            <input asp-for="FechaInicio" type="date" class="form-control" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFin" class="form-label fw-bold"></label>
                            <input asp-for="FechaFin" type="date" class="form-control" />
                            <span asp-validation-for="FechaFin" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver al Listado
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
