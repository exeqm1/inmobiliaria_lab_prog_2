@model RescindirViewModel

@{
    ViewData["Title"] = "Rescindir Reserva";
    string min = Model.FechaInicio.AddDays(1).ToString("yyyy-MM-dd");
    string max = Model.FechaFin.AddDays(-1).ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-scissors me-2"></i>Rescindir Reserva #@Model.Id
                </h5>
            </div>
            <div class="card-body p-4">
                <dl class="row muted-panel p-3 mb-4">
                    <dt class="col-sm-5">Inmueble</dt>
                    <dd class="col-sm-7">@Model.InmuebleDescripcion</dd>

                    <dt class="col-sm-5">Rango original</dt>
                    <dd class="col-sm-7">@Model.FechaInicio.ToString("dd/MM/yyyy") — @Model.FechaFin.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-5">Monto Diario</dt>
                    <dd class="col-sm-7">$@Model.MontoDiario.ToString("N2")</dd>
                </dl>

                <form asp-action="Rescindir" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FechaFinEfectiva" class="form-label fw-bold"></label>
                        <input asp-for="FechaFinEfectiva" type="date" class="form-control" min="@min" max="@max" />
                        <span asp-validation-for="FechaFinEfectiva" class="text-danger small"></span>
                        <div class="form-text">Debe ser posterior al inicio y anterior al fin original.</div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-cash-coin me-1"></i>
                        Multa calculada (50% de los días no usados): <strong>$@Model.MultaEstimada.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-check2-circle me-1"></i>Confirmar Rescisión
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
