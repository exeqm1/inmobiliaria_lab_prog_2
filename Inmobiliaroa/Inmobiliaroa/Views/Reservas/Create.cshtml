@model ReservaFormViewModel

@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-calendar-plus me-2"></i>Registrar Reserva
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="InmuebleId" class="form-label fw-bold"></label>
                        @await Html.PartialAsync("_ComboBusqueda", new ComboBusquedaViewModel
                        {
                            Id = "InmuebleId",
                            Nombre = "InmuebleId",
                            Url = Url.Action("Buscar", "Inmuebles", new { disponibles = true })!,
                            Valor = Model.InmuebleId > 0 ? Model.InmuebleId.ToString() : string.Empty,
                            Texto = ViewBag.InmuebleTexto as string ?? string.Empty,
                            Placeholder = "Buscar inmueble por dirección o tipo..."
                        })
                        <span asp-validation-for="InmuebleId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InquilinoId" class="form-label fw-bold"></label>
                        @await Html.PartialAsync("_ComboBusqueda", new ComboBusquedaViewModel
                        {
                            Id = "InquilinoId",
                            Nombre = "InquilinoId",
                            Url = Url.Action("Buscar", "Inquilinos")!,
                            Valor = Model.InquilinoId > 0 ? Model.InquilinoId.ToString() : string.Empty,
                            Texto = ViewBag.InquilinoTexto as string ?? string.Empty,
                            Placeholder = "Buscar inquilino por nombre o DNI..."
                        })
                        <span asp-validation-for="InquilinoId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicio" class="form-label fw-bold"></label>
                            <input asp-for="FechaInicio" type="date" class="form-control" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFin" class="form-label fw-bold"></label>
                            <input asp-for="FechaFin" type="date" class="form-control" />
                            <span asp-validation-for="FechaFin" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        El monto diario se toma del precio del inmueble y queda congelado al momento de crear la reserva.
                        El sistema valida que no exista otra reserva activa superpuesta.
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver al Listado
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i>Guardar Reserva
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
