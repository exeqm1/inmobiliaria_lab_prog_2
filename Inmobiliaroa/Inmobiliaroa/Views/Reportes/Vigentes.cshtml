@model InformeReservasViewModel

@{
    ViewData["Title"] = "Reservas Vigentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-calendar-check text-primary me-2"></i>Reservas Vigentes
        </h2>
        <small class="text-muted">Al @Model.Fecha.ToString("dd/MM/yyyy") — @Model.Reservas.Count reserva(s)</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al Panel
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Vigentes" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="fecha" class="form-label fw-semibold">Fecha de referencia</label>
                <input type="date" id="fecha" name="fecha" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Generar
                </button>
                <a asp-action="Vigentes" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Hoy
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 70px;">Código</th>
                    <th scope="col">Inmueble</th>
                    <th scope="col">Inquilino</th>
                    <th scope="col" class="text-center">Desde</th>
                    <th scope="col" class="text-center">Hasta</th>
                    <th scope="col" class="text-end" style="width: 120px;">Total</th>
                    <th scope="col" class="text-end" style="width: 120px;">Cobrado</th>
                    <th scope="col" class="text-end" style="width: 120px;">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Reservas.Any())
                {
                    foreach (var item in Model.Reservas)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">#@item.Id</a>
                            </td>
                            <td>@item.Inmueble</td>
                            <td>@item.Inquilino</td>
                            <td class="text-center">@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@(item.FechaFinEfectiva ?? item.FechaFin).ToString("dd/MM/yyyy")</td>
                            <td class="text-end">$@item.Total.ToString("N2")</td>
                            <td class="text-end text-success">$@item.TotalPagado.ToString("N2")</td>
                            <td class="text-end @(item.Saldo > 0 ? "text-danger" : "text-success")">$@item.Saldo.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay reservas vigentes en esa fecha.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
