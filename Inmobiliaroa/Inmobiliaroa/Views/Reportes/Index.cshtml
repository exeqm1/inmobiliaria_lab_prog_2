@model DashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
    var porcentajeDisponibles = Model.InmueblesActivos == 0
        ? 0
        : (int)Math.Round(Model.InmueblesDisponibles * 100.0 / Model.InmueblesActivos);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Panel de Control
        </h2>
        <small class="text-muted">Resumen general del sistema al @DateTime.Today.ToString("dd/MM/yyyy")</small>
    </div>
    <a asp-action="Reservas" class="btn btn-primary">
        <i class="bi bi-calendar-range me-1"></i>Reporte de Reservas
    </a>
</div>

<div class="card mb-4">
    <div class="card-body d-flex flex-wrap gap-2">
        <span class="text-muted small text-uppercase align-self-center me-2">Informes:</span>
        <a asp-action="Inmuebles" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-buildings me-1"></i>Inmuebles y Dueños
        </a>
        <a asp-action="MasReservados" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-trophy me-1"></i>Más Reservados
        </a>
        <a asp-action="SinReservas" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-calendar-x me-1"></i>Sin Reservas
        </a>
        <a asp-action="Vigentes" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-calendar-check me-1"></i>Reservas Vigentes
        </a>
        <a asp-action="PorTerminar" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-hourglass-split me-1"></i>Por Terminar
        </a>
        <a asp-action="Libres" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-calendar2-range me-1"></i>Inmuebles Libres
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3 kpi-icon">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase">Propietarios</div>
                    <div class="fs-4 fw-bold">@Model.PropietariosActivos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center me-3 kpi-icon">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase">Inquilinos</div>
                    <div class="fs-4 fw-bold">@Model.InquilinosActivos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center me-3 kpi-icon">
                    <i class="bi bi-buildings fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase">Inmuebles</div>
                    <div class="fs-4 fw-bold">@Model.InmueblesActivos</div>
                    <div class="small text-muted">@Model.InmueblesDisponibles disponibles (@porcentajeDisponibles%)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center me-3 kpi-icon">
                    <i class="bi bi-calendar-check fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase">Reservas Vigentes</div>
                    <div class="fs-4 fw-bold">@Model.ReservasVigentes</div>
                    <div class="small text-muted">@Model.ReservasFinalizadas finalizadas</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Ingresos Cobrados</div>
                <div class="display-6 fw-bold text-success">$@Model.IngresosTotales.ToString("N2")</div>
                <div class="small text-muted">@Model.PagosRegistrados pago(s) vigente(s)</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Reservas Canceladas</div>
                <div class="display-6 fw-bold text-secondary">@Model.ReservasCanceladas</div>
                <div class="small text-muted">Dadas de baja lógicamente</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Estado de la Operación</div>
                <div class="fs-5 fw-semibold mt-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle me-1">@Model.ReservasVigentes vigentes</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@Model.ReservasFinalizadas finalizadas</span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@Model.ReservasCanceladas canceladas</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header py-3">
                <h3 class="h6 mb-0 fw-bold"><i class="bi bi-calendar-event text-primary me-1"></i>Próximas Reservas</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Inmueble</th>
                            <th>Inquilino</th>
                            <th class="text-center">Desde</th>
                            <th class="text-center">Hasta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProximasReservas.Any())
                        {
                            foreach (var reserva in Model.ProximasReservas)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva.Id" class="text-decoration-none">
                                            @reserva.Inmueble?.Direccion
                                        </a>
                                    </td>
                                    <td>@reserva.Inquilino?.NombreCompleto</td>
                                    <td class="text-center">@reserva.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@reserva.FechaFin.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay reservas próximas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header py-3">
                <h3 class="h6 mb-0 fw-bold"><i class="bi bi-pie-chart text-success me-1"></i>Ingresos por Tipo de Inmueble</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo</th>
                            <th class="text-center">Reservas</th>
                            <th class="text-end">Cobrado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.IngresosPorTipo.Any())
                        {
                            foreach (var item in Model.IngresosPorTipo)
                            {
                                <tr>
                                    <td>@item.TipoDescripcion</td>
                                    <td class="text-center">@item.CantidadReservas</td>
                                    <td class="text-end">$@item.IngresosCobrados.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>Sin datos para mostrar.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
