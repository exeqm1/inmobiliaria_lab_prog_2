@model InformeMasReservadosViewModel

@{
    ViewData["Title"] = "Inmuebles Más Reservados";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-trophy text-primary me-2"></i>Inmuebles Más Reservados
        </h2>
        <small class="text-muted">Últimos @Model.Dias días</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al Panel
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="MasReservados" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="dias" class="form-label fw-semibold">Cantidad de días</label>
                <input type="number" id="dias" name="dias" class="form-control" min="1" max="3650" value="@Model.Dias" />
            </div>
            <div class="col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Generar
                </button>
                <a asp-action="MasReservados" asp-route-dias="365" class="btn btn-outline-secondary">Último año</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 80px;">Código</th>
                    <th scope="col">Dirección</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Propietario</th>
                    <th scope="col" class="text-center" style="width: 120px;">Reservas</th>
                    <th scope="col" class="text-center" style="width: 140px;">Última Reserva</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Inmuebles.Any())
                {
                    foreach (var item in Model.Inmuebles)
                    {
                        <tr>
                            <td class="fw-semibold">#@item.Id</td>
                            <td>@item.Direccion</td>
                            <td>@item.Tipo</td>
                            <td>@item.Propietario</td>
                            <td class="text-center fw-bold">@item.CantidadReservas</td>
                            <td class="text-center">
                                @(item.UltimaReserva.HasValue ? item.UltimaReserva.Value.ToString("dd/MM/yyyy") : "—")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay inmuebles para mostrar.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
