@model InformeReservasViewModel

@{
    ViewData["Title"] = "Reservas por Terminar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-hourglass-split text-primary me-2"></i>Reservas por Terminar
        </h2>
        <small class="text-muted">
            Desde @Model.Fecha.ToString("dd/MM/yyyy") hasta @Model.Fecha.AddDays(Model.Dias).ToString("dd/MM/yyyy") — @Model.Reservas.Count reserva(s)
        </small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al Panel
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="PorTerminar" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="fecha" class="form-label fw-semibold">Fecha de referencia</label>
                <input type="date" id="fecha" name="fecha" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label for="dias" class="form-label fw-semibold">Termina en X días</label>
                <input type="number" id="dias" name="dias" class="form-control" min="1" max="365" value="@Model.Dias" />
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Generar
                </button>
                <a asp-action="PorTerminar" asp-route-dias="7" class="btn btn-outline-secondary">7</a>
                <a asp-action="PorTerminar" asp-route-dias="15" class="btn btn-outline-secondary">15</a>
                <a asp-action="PorTerminar" asp-route-dias="30" class="btn btn-outline-secondary">30</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 70px;">Código</th>
                    <th scope="col">Inmueble</th>
                    <th scope="col">Inquilino</th>
                    <th scope="col" class="text-center">Desde</th>
                    <th scope="col" class="text-center">Finaliza</th>
                    <th scope="col" class="text-end" style="width: 120px;">Total</th>
                    <th scope="col" class="text-end" style="width: 120px;">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Reservas.Any())
                {
                    foreach (var item in Model.Reservas)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">#@item.Id</a>
                            </td>
                            <td>@item.Inmueble</td>
                            <td>@item.Inquilino</td>
                            <td class="text-center">@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-center fw-semibold">@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">$@item.Total.ToString("N2")</td>
                            <td class="text-end @(item.Saldo > 0 ? "text-danger" : "text-success")">$@item.Saldo.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay reservas que terminen en ese plazo.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
