@model InformeInmueblesViewModel

@{
    ViewData["Title"] = "Inmuebles y Dueños";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800">
            <i class="bi bi-buildings text-primary me-2"></i>Inmuebles y Dueños
        </h2>
        <small class="text-muted">Total: @Model.Inmuebles.Count inmueble(s)</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver al Panel
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Inmuebles" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="disponible" class="form-label fw-semibold">Disponibilidad</label>
                <select id="disponible" name="disponible" class="form-select">
                    <option value="">Todas</option>
                    <option value="true" selected="@(Model.Disponible == true ? "selected" : null)">Disponibles</option>
                    <option value="false" selected="@(Model.Disponible == false ? "selected" : null)">No disponibles</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="propietarioId" class="form-label fw-semibold">Propietario</label>
                <select id="propietarioId" name="propietarioId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var propietario in Model.Propietarios)
                    {
                        <option value="@propietario.Id" selected="@(Model.PropietarioId == propietario.Id ? "selected" : null)">@propietario.NombreCompleto</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
                <a asp-action="Inmuebles" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 80px;">Código</th>
                    <th scope="col">Dirección</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Propietario</th>
                    <th scope="col" class="text-center" style="width: 70px;">Cupo</th>
                    <th scope="col" class="text-end" style="width: 120px;">Precio/Día</th>
                    <th scope="col" class="text-center" style="width: 120px;">Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Inmuebles.Any())
                {
                    foreach (var item in Model.Inmuebles)
                    {
                        <tr>
                            <td class="fw-semibold">#@item.Id</td>
                            <td>@item.Direccion</td>
                            <td>@item.Tipo</td>
                            <td>@item.Propietario</td>
                            <td class="text-center">@item.Cupo</td>
                            <td class="text-end">$@item.PrecioDia.ToString("N2")</td>
                            <td class="text-center">
                                @if (item.Disponible)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">No disponible</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay inmuebles con esos filtros.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
