root = true

# Estándar común del equipo: UTF-8, fin de línea Windows, espacios de 4.
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# Directivas using del sistema primero
dotnet_sort_system_directives_first = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{cshtml,razor}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
